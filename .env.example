# Firebase Configuration
# Copy this file to .env.local and fill in your values
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=examcanada.firebaseapp.com
